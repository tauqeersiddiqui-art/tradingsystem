# ================= MODE =================
# Broker is always ZerodhaBroker (real credentials required).
# DRY_RUN=1  → simulated fills at current LTP, no real Zerodha orders
# DRY_RUN=0  → LIVE execution — real market orders sent to Zerodha NFO
#
# PAPER_MODE=1 → candle buffer seeds from existing CSV only
# PAPER_MODE=0 → candle buffer seeds from live Zerodha data (preferred)
#
# Set DRY_RUN=0 and PAPER_MODE=0 to go fully live.

PAPER_MODE=0              # live Zerodha WebSocket feed + live historical seed
DRY_RUN=1                 # simulated fills at real market LTP (no real orders)
TEST_MODE=1               # run anytime (no market-hours schedule gate)


# ================= RISK =================

INITIAL_CAPITAL=100000
MAX_RISK_PER_TRADE_PCT=0.01
MAX_LOTS_CAP=10

# ================= ML =================

ML_ON=1
CHAMPION_THRESHOLD=0.40

# ====================================================================
# AI BRAIN (FreeLLMAPI / OpenAI-Compatible)
# ====================================================================
# Advisory only.
# Triggered after consecutive losses.
# Can ONLY make the bot more selective.
# Cannot:
#   - Place trades
#   - Increase position size
#   - Loosen stop losses
#   - Override exits
#   - Force entries

AI_REVIEW_ENABLED=1
AI_REVIEW_AFTER_LOSSES=2

# Hard safety switches
AI_CAN_BLOCK_TRADES=0
AI_CAN_CHANGE_SIZE=0
AI_CAN_CHANGE_STOPS=0

# FreeLLMAPI Unified Key
LLM_API_KEY=freellmapi-618c17184329a17630d1e1c88fbc7db81bb390e891a2ab11

# Local FreeLLMAPI Endpoint
LLM_BASE_URL=http://localhost:3001/v1

# Router automatically selects best available model
LLM_MODEL=auto

# Optional fixed models (uncomment ONE if desired)
# LLM_MODEL=gemini-2.5-flash
# LLM_MODEL=gpt-4o
# LLM_MODEL=openai/gpt-4.1
# LLM_MODEL=deepseek-ai/deepseek-v4-pro
# LLM_MODEL=qwen/qwen3-coder:free
# LLM_MODEL=llama-3.3-70b-versatile

# ====================================================================
# SESSION LIMITS
# ====================================================================

# Maximum trades allowed per day
MAX_TRADES_PER_DAY=50

# Scalp momentum engine
SCALP_ENABLED=1
				#0 to disabled / 1 to enable
# Require 15pt BankNifty spot move before scalp fires (was 12pt default).
# All 3 losing open scalps today were 12-13pt moves — raising to 15pt blocks them.
SCALP_MOMENTUM_THRESHOLD=15
# Shorter lookback (was 30s): the 15pt move must be RECENT so we enter on FRESH
# momentum still running, not a stale move that already exhausted. Diagnosis on
# 2026-06-29 showed every losing scalp stopped in 3-9s (bought the local top),
# while the one 16s survivor made +618 — late entry was the root cause.
SCALP_MOMENTUM_WINDOW=20
# Looser stops (was SL=3 LOCK=2 TRAIL=2): give the trade room to survive the
# normal 3-4pt post-entry wobble so a real move can resume instead of stopping
# out instantly. Each stop is a bit bigger but far fewer of them trigger.
SCALP_SL_PTS=5
SCALP_LOCK_PTS=3
SCALP_TRAIL_PTS=4
# Longer cooldown between scalps: 120s reduces rapid re-entry after stop losses
SCALP_COOLDOWN=120
# Min positive ML edge required for scalp. Raised from 0.08 to block near-neutral entries.
SCALP_ML_MIN_EDGE=0.12
# Scalp size halved 2->1 lot (2026-06-29): scalp losses are structural gap-throughs
# no filter can prevent — every trade still fires, but each loss hurts half as much.
SCALP_LOTS=1
# Cooldown after any completed trade
REENTRY_COOLDOWN=180

# Prevent immediate re-entry into same option contract
SAME_SYMBOL_COOLDOWN=240

# Approximate round-trip cost per lot
COST_PER_LOT=66

# BANKNIFTY option lot size used for normal ML orders
LOT_SIZE=30

# ====================================================================
# SESSION FILTERS
# ====================================================================

# Keep disabled during paper testing
# Enable when moving to real-money trading
LUNCH_FILTER_ENABLED=0

# ====================================================================
# FUTURE LIVE TRADING SETTINGS
# ====================================================================
# Uncomment only after validating with replay/live-paper diagnostics.
#
