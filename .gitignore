ml/models/training_dataset*.csv
ml/models/day_classifier_labels.csv

# Temporary ML files
ml/tmp/

# Logs
logs/

# Archive (old experiments / backups)
archive/

# Secrets
.env
access_token.txt

# OS files
.DS_Store
Thumbs.db
