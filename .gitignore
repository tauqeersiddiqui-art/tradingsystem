# ============================================================
# 🔐 SECRETS — NEVER COMMIT
# ============================================================
.env
.env.*
*.env
access_token.txt
*.key
*.pem
*.p12

# ============================================================
# 🧠 ML ARTIFACTS — models, datasets, training outputs
# ============================================================
ml/models/
ml/tmp/
ml/**/__pycache__/

# Specific model formats
*.pkl
*.h5
*.pt
*.joblib
*.onnx

# Training datasets / backups
*.csv
*.csv.bak

# Generated ML metadata
ml/models/*_threshold.txt
ml/models/*_features.txt
ml/models/*_candidate.pkl

# ============================================================
# 📊 DATA — runtime + historical (NEVER IN GIT)
# ============================================================
data/
!data/README.md   # allow documentation only

data/**/*.csv
data/**/*.json
data/**/*.jsonl

# Runtime state
data/runtime_state.json
data/system_health.json
data/.telegram_state.json
data/.master_runner.pid

# ============================================================
# 📈 BACKTEST / ANALYTICS OUTPUT
# ============================================================
backtest/results/
backtest/*.csv
backtest/*.json

# ============================================================
# 🧾 LOGS
# ============================================================
logs/
*.log
*.jsonl

# ============================================================
# 📡 TELEGRAM / SESSION STATE
# ============================================================
.telegram_state.json

